# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (للبيئة المحلية)
DB_HOST=127.0.0.1
DB_PORT=9470
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=cvpro_db

# Cloud SQL Engine Connection (للسيرفر السحابي فقط)
INSTANCE_CONNECTION_NAME=cvprosimple:me-west1:cvpro-postgres

# Connection Pool Management
POOL_MAX=10
POOL_IDLE_TIMEOUT=30000

# Proxy Targeting
BACKEND_URL=http://localhost:5000